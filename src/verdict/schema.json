{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict.schema.json",
  "title": "Envelope (SPEC/00 section 6 as amended by ADR-0004: checks, and scope on each result; amendment 2: control_card_ref, tokens_in; ADR-0007: schema_version 2, mode, runtime_arn, region, model_version)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commit",
    "tag",
    "model_id",
    "guardrail_version",
    "judge_model_id",
    "corpus_fingerprint",
    "cache_state",
    "baseline_card_ref",
    "goldens",
    "regressed",
    "fragile",
    "never_passed",
    "plants_expected",
    "plants_fired",
    "guardrail_hits",
    "p95_ms",
    "tokens_out",
    "cost_usd",
    "rejected_over_ceiling",
    "alarm_latency_s",
    "checks",
    "verdict"
  ],
  "properties": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "guardrail_version": {
      "description": "null until a guardrail exists (M03).",
      "type": [
        "string",
        "null"
      ]
    },
    "judge_model_id": {
      "description": "null until the judge is picked (M03).",
      "type": [
        "string",
        "null"
      ]
    },
    "corpus_fingerprint": {
      "description": "null until the corpus exists (M01). M03 makes null a failure (F3.4).",
      "type": [
        "string",
        "null"
      ]
    },
    "cache_state": {
      "enum": [
        "bypass",
        "disabled",
        "uncacheable"
      ]
    },
    "baseline_card_ref": {
      "description": "The base this run is a delta against. Required: F0.2. From M01 (ADR-0004 amendment 2), on an agent envelope, the card at tag m00 whose hash is thresholds.yaml baseline_card.sha256.",
      "$ref": "#/$defs/card_ref"
    },
    "control_card_ref": {
      "description": "This run's control card, <commit>.baseline-card.json (P6). From M01 (ADR-0004 amendment 2). Not required, so M00's envelopes still validate; verdict.gate rejects an agent envelope without it.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/card_ref"
        }
      ]
    },
    "goldens": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^g-[0-9]{3}$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "score",
            "cites",
            "pass"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ordinary",
                "trap",
                "guardrail",
                "redteam"
              ]
            },
            "scope": {
              "description": "control: the baseline's own reply, reported and never gated. agent: the agent under test, which the regression bar reads. No third value until a milestone needs one (ADR-0004).",
              "enum": [
                "control",
                "agent"
              ]
            },
            "score": {
              "type": "boolean"
            },
            "cites": {
              "description": "Row and clause present and existing. null for guardrail and redteam.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "pass": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "regressed": {
      "$ref": "#/$defs/golden_ids"
    },
    "fragile": {
      "$ref": "#/$defs/golden_ids"
    },
    "never_passed": {
      "$ref": "#/$defs/golden_ids"
    },
    "plants_expected": {
      "type": "integer",
      "minimum": 0
    },
    "plants_fired": {
      "type": "integer",
      "minimum": 0
    },
    "guardrail_hits": {
      "type": "integer",
      "minimum": 0
    },
    "p95_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "tokens_in": {
      "description": "From M01 (ADR-0004 amendment 2). tokens_in + tokens_out over thresholds.yaml cost_cap.tokens_per_run is RED. Not required, so M00's envelopes still validate; verdict.gate rejects an agent envelope without it.",
      "type": "integer",
      "minimum": 0
    },
    "agent_tokens": {
      "description": "From M04 PR 2 (SPEC/04 §2). The agent's own tokens, in plus out, in the first agent run: the number the relative token bar reads. Optional, so no envelope before it becomes invalid; tokens_in and tokens_out count every run the job made, and with A-vs-A they hold two agent runs.",
      "type": "integer",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "description": "null at M00: no seat owns a price table yet. The cap is in tokens.",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "rejected_over_ceiling": {
      "description": "null until ceilings exist (M01).",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "alarm_latency_s": {
      "description": "From M05 PR 2 (SPEC/05 section 2): the largest latency, in seconds, from an attempt's own time in AWS's record to its record's arrival in the security account's audit bucket, across the attempts recorded in `containment`. null when none was recorded, or before M05 PR 2.",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "checks": {
      "description": "Keyed by falsifier id. pass: the falsifier did not fire. url: the CI evidence.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^F[0-9]+_[0-9]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "url"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "GREEN",
        "RED",
        "UNMEASURED"
      ]
    },
    "schema_version": {
      "description": "ADR-0007. Absent: version 1, every envelope before it. 2: the four fields below are required.",
      "const": 2
    },
    "mode": {
      "description": "ADR-0007. Where the subject ran: control (no agent ran), runner (refagent's code in the CI runner), runtime (the deployed AgentCore runtime).",
      "enum": ["control", "runner", "runtime"]
    },
    "runtime_arn": {
      "description": "ADR-0007. The runtime called, or null. The gate refuses runtime without an ARN, and an ARN without runtime.",
      "type": ["string", "null"]
    },
    "region": {
      "description": "ADR-0007, T2. The request region, as the run reports it.",
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "description": "ADR-0007, T1. The manifest's pinned version; null where Bedrock gives none (ruling p).",
      "type": ["string", "null"]
    },
    "a_vs_a": {
      "description": "From M04 PR 2 (SPEC/04 §6, F4.3). Written when a second run of the same pin ran in the same job: the golden ids whose pass differ between the two runs, for the agent (gated as checks.F4_3) and for the control (recorded, never gated; null when the control ran once). Optional, so no envelope before it becomes invalid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "control"],
      "properties": {
        "agent": {"$ref": "#/$defs/golden_ids"},
        "control": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/golden_ids"}]}
      }
    },
    "containment": {
      "description": "From M05 PR 2 (SPEC/05 section 4). The live attempts as scripts/observe_containment.py read them from the security account's audit bucket and verdict.build read them: per seed, made, refused by the control named for it, recorded, and the latency of its record. Recorded, never gated; the ledger's row 5 reading reads it. Optional, so no envelope before it becomes invalid.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readable",
        "error",
        "looked_up_at",
        "max_seconds",
        "quarantine_attached",
        "seeds"
      ],
      "properties": {
        "readable": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "looked_up_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "quarantine_attached": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seed",
              "falsifiers",
              "made",
              "refused",
              "recorded",
              "latency_s",
              "within_n",
              "reasons",
              "attempts"
            ],
            "properties": {
              "seed": {
                "type": "string"
              },
              "falsifiers": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "made": {
                "type": "boolean"
              },
              "refused": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "recorded": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "latency_s": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "within_n": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "attempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "what",
                    "event_name",
                    "recorded",
                    "timings",
                    "principal",
                    "error_code",
                    "error_message",
                    "record_key"
                  ],
                  "properties": {
                    "what": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "event_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "recorded": {
                      "type": "boolean"
                    },
                    "principal": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "error_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "error_message": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "record_key": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "timings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "of",
                          "event_time",
                          "delivered",
                          "latency_s"
                        ],
                        "properties": {
                          "of": {
                            "type": "string"
                          },
                          "event_time": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "delivered": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "latency_s": {
                            "type": [
                              "number",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "template": {
      "description": "From M06 PR 2 (SPEC/06 section 4). Claim 6's live readings as scripts/observe_template.py read GitHub, AWS and Grafana and verdict.build (src/verdict/template.py) ruled on them: F6.1's live half, F6.2, F6.3 and F6.4's live half, each read or not, held or not, with its reasons. Recorded, never gated; the ledger's row 6 reading reads it. Optional, so no envelope before it becomes invalid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["looked_up_at", "max_seconds", "platform_app_id", "F6_1", "F6_2", "F6_3", "F6_4"],
      "properties": {
        "looked_up_at": {"type": ["string", "null"]},
        "max_seconds": {"type": "number", "exclusiveMinimum": 0},
        "platform_app_id": {"type": ["integer", "null"]},
        "F6_1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "held", "reasons"],
          "properties": {
            "read": {"type": "boolean"},
            "held": {"type": ["boolean", "null"]},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "faulty_commits": {"type": "integer", "minimum": 0}
          }
        },
        "F6_2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "held", "reasons"],
          "properties": {
            "read": {"type": "boolean"},
            "held": {"type": ["boolean", "null"]},
            "reasons": {"type": "array", "items": {"type": "string"}}
          }
        },
        "F6_3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "held", "reasons", "elapsed_s", "records", "listed"],
          "properties": {
            "read": {"type": "boolean"},
            "held": {"type": ["boolean", "null"]},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "elapsed_s": {"type": ["number", "null"]},
            "listed": {"type": "boolean"},
            "records": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "created_at": {"type": ["string", "null"]},
                "merged_at": {"type": ["string", "null"]},
                "deployed_at": {"type": ["string", "null"]},
                "answered_at": {"type": ["string", "null"]}
              }
            }
          }
        },
        "F6_4": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "held", "reasons", "not_in_registry"],
          "properties": {
            "read": {"type": "boolean"},
            "held": {"type": ["boolean", "null"]},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "not_in_registry": {"type": ["array", "null"], "items": {"type": "string"}}
          }
        }
      }
    },
    "swaps": {
      "description": "From M04 PR 3 (SPEC/04 §4). The M04 swap PRs as scripts/rule_swaps.py read them: GitHub's record of each pull and the gate's verdict on that pull's own envelope. Recorded, never gated (Product, M04 PR 3). Optional, so no envelope before it becomes invalid.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["swap", "falsifier", "role", "pr", "merged", "head_sha", "envelope_commit", "measured_commit", "evals_on_measured", "required_on_head", "verdict", "reasons", "note"],
        "properties": {
          "swap": {"type": "string"},
          "falsifier": {"type": ["string", "null"]},
          "role": {"type": ["string", "null"]},
          "pr": {"type": ["integer", "null"]},
          "merged": {"type": ["boolean", "null"]},
          "head_sha": {"type": ["string", "null"]},
          "envelope_commit": {"type": ["string", "null"]},
          "measured_commit": {"type": ["string", "null"]},
          "evals_on_measured": {"type": ["string", "null"]},
          "required_on_head": {"type": ["object", "null"], "additionalProperties": {"type": ["string", "null"]}},
          "verdict": {"enum": ["GREEN", "RED", "UNMEASURED", "REJECTED", null]},
          "reasons": {"type": "array", "items": {"type": "string"}},
          "note": {"type": ["string", "null"]}
        }
      }
    }
  },
  "dependentRequired": {
    "mode": ["schema_version"],
    "runtime_arn": ["schema_version"],
    "region": ["schema_version"],
    "model_version": ["schema_version"]
  },
  "if": {"required": ["schema_version"]},
  "then": {"required": ["mode", "runtime_arn", "region", "model_version"]},
  "$defs": {
    "card_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "golden_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^g-[0-9]{3}$"
      }
    }
  }
}
